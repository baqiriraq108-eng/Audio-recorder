<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer subtle circular border ring (44dp x 44dp container) -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="44dp"
                android:height="44dp" />
            <solid android:color="#1F1F21" />
            <stroke
                android:width="1.5dp"
                android:color="#48484A" />
        </shape>
    </item>
    <!-- Inner rounded red square stop indicator (#FF3B30), 16dp x 16dp with 3dp corner radius centered -->
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="rectangle">
            <size
                android:width="16dp"
                android:height="16dp" />
            <solid android:color="#FF3B30" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
