<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_recording_compact_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_recording_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/notif_recording_compact_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/notification_status_recording"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_mic"
        android:tint="#F08C4B" />

    <TextView
        android:id="@+id/notif_recording_compact_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/notification_status_recording"
        android:textColor="#F4D7C7"
        android:textSize="14sp" />

    <Chronometer
        android:id="@+id/notif_recording_compact_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#F08C4B"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
