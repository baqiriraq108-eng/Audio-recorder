<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_finished_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/notif_finished_badge"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/notification_finished_recording"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notif_finished_check" />

    <TextView
        android:id="@+id/notif_finished_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/notification_finished_recording"
        android:textColor="#E6E1E5"
        android:textSize="15sp"
        android:textStyle="normal" />

</LinearLayout>
