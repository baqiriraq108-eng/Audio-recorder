<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_append_confirm_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_recording_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Top Row: Equal-Width Greek Confirmation Buttons (Θ Don't / Σ Save) -->
    <LinearLayout
        android:id="@+id/notif_append_buttons_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/notif_append_dont_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_append_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/notif_append_dont_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Don't"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notif_greek_theta" />

            <TextView
                android:id="@+id/notif_append_dont_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Don't"
                android:textColor="#F4D7C7"
                android:textSize="15sp"
                android:textStyle="normal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_append_save_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_append_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/notif_append_save_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Save"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notif_greek_sigma" />

            <TextView
                android:id="@+id/notif_append_save_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Save"
                android:textColor="#F4D7C7"
                android:textSize="15sp"
                android:textStyle="normal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Row: Recording Name Input Field Directly Beneath the Greek Action Buttons -->
    <FrameLayout
        android:id="@+id/notif_append_title_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:minHeight="48dp">

        <TextView
            android:id="@+id/notif_append_title_display"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_notif_title_input"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="#F4D7C7"
            android:textSize="14sp" />
    </FrameLayout>

</LinearLayout>
